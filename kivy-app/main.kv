# HERO BANNER
Home:
<Home>:

    MDBanner:
        id:m_banner
        text:['This is app banner.']
        over_widget:banner
        left_action:['Cancel',lambda x: root.left_button()]
        right_action:['Close',lambda x: root.right_button()]

    MDBoxLayout:
        orientation:'vertical'
        id:banner
        size_hint_y:None
        height:Window.height

    MDProgressBar:
        id:progress
        type:'determinate'
        running_duration:3

    MDRaisedButton:
        text:'Progress Bar'
        pos:100,250
        on_press:progress.start()
        on_release:progress.stop()

    MDSpinner:
        size_hint:None,None
        size:dp(50),dp(50)
        pos:100,350
        active:True if check.active else False

    MDCheckbox:
        id:check
        pos:100,400

    MDRaisedButton:
        text:'Clck Here'
        pos:300,400
        on_release:m_banner.show()
