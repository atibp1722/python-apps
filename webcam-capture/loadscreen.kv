#:kivy 2.1.0
<CamScreen>:
    GridLayout:
        cols:1
        padding:5
        spacing:5
        Camera:
            id:camera
            resolution:(640,480)
            play:False
            size_hint_y:0.7
        Button:
            id:btn
            text:'Start Camera'
            on_press:root.start() if root.ids.camera.play==False else root.stop()
            size_hint_y:0.15
        Button:
            text:'Capture Image'
            on_press:root.capture()
            size_hint_y:0.15

<CapturedImgScreen>:
    GridLayout:
        cols:1
        padding:5
        spacing:5
        Image:
            id:img
            source:''
            size_hint_y:0.7
        Button:
            text:'Create Link'
            on_press:root.create_link()
            size_hint_y:0.1
        Label:
            id:lbl
            text:''
            size_hint_y:0.1
        GridLayout:
            cols:2
            size_hint_y:0.1
            Button:
                text:'Copy Link'
                on_press:root.copy_link()
            Button:
                text:'Open Link'
                on_press:root.open_link()

<RootWidget>:
    CamScreen:
        id:cam_screen
        name:'cam_screen'
    CapturedImgScreen:
        id:img_screen
        name:'img_screen'